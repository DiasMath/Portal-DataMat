# Firebase Configuration (configure com os valores do seu projeto Firebase)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (necessário para criação de usuários)
# Para obter esta chave, vá em Firebase Console > Project Settings > Service Accounts
# e gere uma nova chave privada. Cole o conteúdo JSON completo aqui (em uma linha)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Chave de criptografia para senhas de conexões SQL (AES-256-GCM)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SQL_ENCRYPTION_KEY=

# Segredos da Aplicação Azure AD (Service Principal)
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=

# IDs do Workspace e Relatório do Power BI
PBI_GROUP_ID=
PBI_REPORT_ID=

# Constantes da API (não precisam ser segredos, mas bom ter aqui)
PBI_AUTHORITY_URL=
PBI_SCOPE=
PBI_API_BASE_URL=